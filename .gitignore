# Rust
/target/
**/*.rs.bk
*.pdb

# Cargo: this is a binary crate, so Cargo.lock IS committed. Do not ignore it.

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Local env / secrets (plugin config lives in HERDR_PLUGIN_CONFIG_DIR, never here)
.env
.env.*

# QA artifacts (screenshots are regenerated by the QA loop; keep only curated
# before/after shots that are explicitly force-added under docs/qa/)
/qa/out/
*.png
!docs/qa/**/*.png

# insta snapshot scratch
*.snap.new
